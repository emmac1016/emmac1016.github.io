---
/**
 * Navigation Component
 * Fixed minimal navigation with smooth scroll to sections
 */

import { resume } from '../data/resume';

const firstName = resume.contact.name.split(' ')[0];

const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#work', label: 'Work' },
  { href: '#skills', label: 'Skills' },
  { href: '#education', label: 'Education' },
];
---

<nav class="nav" aria-label="Main navigation">
  <div class="nav-container">
    <a href="#" class="nav-logo">{firstName}</a>
    <ul class="nav-links" role="list">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="nav-link">{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1rem 0;
    background: rgba(27, 27, 27, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-overlay);
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  @media (min-width: 640px) {
    .nav-container {
      padding: 0 var(--container-padding-md);
    }
  }

  @media (min-width: 1024px) {
    .nav-container {
      padding: 0 var(--container-padding-lg);
    }
  }

  .nav-logo {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-foreground-hover);
    letter-spacing: -0.01em;
  }

  .nav-logo:hover {
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-foreground-muted);
    border-radius: 6px;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--color-foreground-hover);
    background: var(--color-overlay);
  }

  .nav-link[aria-current="true"] {
    color: var(--color-foreground-hover);
  }

  .nav-link:active {
    transform: scale(0.98);
  }

  @media (max-width: 480px) {
    .nav-links {
      gap: 0.25rem;
    }

    .nav-link {
      padding: 0.5rem;
      font-size: 0.8125rem;
    }
  }

  @media print {
    .nav {
      display: none;
    }
  }
</style>
