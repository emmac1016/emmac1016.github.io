---
/**
 * ExperienceCard Component
 * Displays a single job experience entry with proper accessibility
 */

interface Props {
  id: string;
  title: string;
  company: string;
  location: string;
  remote: boolean;
  startDateFormatted: string;
  endDateFormatted: string;
  startDateISO: string;
  endDateISO: string;
  durationFormatted: string;
  highlights: string[];
  isCurrent: boolean;
}

const {
  id,
  title,
  company,
  location,
  remote,
  startDateFormatted,
  endDateFormatted,
  startDateISO,
  endDateISO,
  durationFormatted,
  highlights,
  isCurrent,
} = Astro.props;

const headingId = `experience-${id}`;
---

<article
  class="experience-card"
  aria-labelledby={headingId}
  aria-current={isCurrent ? 'true' : undefined}
>
  <header class="experience-header">
    <div class="experience-title-row">
      <h3 id={headingId} class="experience-title">{title}</h3>
      {isCurrent && (
        <span class="current-badge">
          <span class="sr-only">Status: </span>Current
        </span>
      )}
      {remote && (
        <span class="remote-badge">
          <span class="sr-only">Work arrangement: </span>Remote
        </span>
      )}
    </div>
    <p class="experience-company">
      {company}<span class="experience-location"> · {location}</span>
    </p>
    <p class="experience-dates">
      <time datetime={startDateISO}>{startDateFormatted}</time>
      <span class="sr-only">to</span>
      <span aria-hidden="true"> – </span>
      <time datetime={endDateISO}>{endDateFormatted}</time>
      <span class="experience-duration">({durationFormatted})</span>
    </p>
  </header>

  {highlights.length > 0 && (
    <ul class="experience-highlights" role="list">
      {highlights.map((highlight) => (
        <li>{highlight}</li>
      ))}
    </ul>
  )}
</article>

<style>
  .experience-card {
    padding-bottom: 1.5rem;
  }

  .experience-card:not(:last-child) {
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-overlay);
  }

  .experience-header {
    margin-bottom: 0.75rem;
  }

  .experience-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .experience-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-foreground-hover);
    margin: 0;
  }

  .current-badge,
  .remote-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 9999px;
  }

  .current-badge {
    background: var(--color-accent);
    color: white;
  }

  .remote-badge {
    background: var(--color-overlay);
    color: var(--color-foreground-muted);
  }

  .experience-company {
    font-size: 0.9375rem;
    margin: 0 0 0.25rem 0;
  }

  .experience-location {
    color: var(--color-foreground-muted);
  }

  .experience-dates {
    font-size: 0.875rem;
    color: var(--color-foreground-muted);
    margin: 0;
  }

  .experience-duration {
    margin-left: 0.25rem;
  }

  .experience-highlights {
    margin: 0;
    padding-left: 1.25rem;
    list-style-type: disc;
  }

  .experience-highlights li {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-foreground);
    margin-bottom: 0.375rem;
  }

  .experience-highlights li::marker {
    color: var(--color-foreground-muted);
  }

  .experience-highlights li:last-child {
    margin-bottom: 0;
  }

  /* Screen reader only utility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  @media print {
    .experience-card {
      break-inside: avoid;
    }

    .current-badge,
    .remote-badge {
      border: 1px solid currentColor;
      background: none !important;
      color: black !important;
    }
  }
</style>
