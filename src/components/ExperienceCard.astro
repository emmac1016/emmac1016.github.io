---
/**
 * ExperienceCard Component
 * Product-style card for displaying work experience
 */

interface Props {
  id: string;
  title: string;
  company: string;
  location: string;
  remote: boolean;
  startDateFormatted: string;
  endDateFormatted: string;
  startDateISO: string;
  endDateISO: string;
  durationFormatted: string;
  highlights: string[];
  isCurrent: boolean;
  featured?: boolean;
}

const {
  id,
  title,
  company,
  location,
  remote,
  startDateFormatted,
  endDateFormatted,
  startDateISO,
  endDateISO,
  durationFormatted,
  highlights,
  isCurrent,
  featured = false,
} = Astro.props;

const headingId = `experience-${id}`;
const cardClass = featured ? 'experience-card featured' : 'experience-card compact';
---

<article
  class={cardClass}
  aria-labelledby={headingId}
  aria-current={isCurrent ? 'true' : undefined}
>
  <header class="card-header">
    <div class="card-meta">
      <time datetime={startDateISO}>{startDateFormatted}</time>
      <span class="sr-only">to</span>
      <span aria-hidden="true"> – </span>
      <time datetime={endDateISO}>{endDateFormatted}</time>
    </div>
    <div class="card-badges">
      {isCurrent && (
        <span class="badge badge-current">
          <span class="sr-only">Status: </span>Current
        </span>
      )}
      {remote && (
        <span class="badge badge-remote">
          <span class="sr-only">Work arrangement: </span>Remote
        </span>
      )}
    </div>
  </header>

  <div class="card-content">
    <h3 id={headingId} class="card-title">{title}</h3>
    <p class="card-company">
      {company}
      <span class="card-location"> · {location}</span>
    </p>

    {featured && highlights.length > 0 && (
      <ul class="card-highlights" role="list">
        {highlights.slice(0, 2).map((highlight) => (
          <li>{highlight}</li>
        ))}
      </ul>
    )}
  </div>

  <footer class="card-footer">
    <span class="card-duration">{durationFormatted}</span>
  </footer>
</article>

<style>
  /* Featured Card Style */
  .experience-card.featured {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 1.5rem;
    background: var(--color-overlay);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .experience-card.featured:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  /* Compact Card Style */
  .experience-card.compact {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-overlay);
  }

  .experience-card.compact:last-child {
    border-bottom: none;
  }

  /* Card Header */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .card-meta {
    font-size: 0.8125rem;
    color: var(--color-foreground-muted);
  }

  .card-badges {
    display: flex;
    gap: 0.375rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    border-radius: 4px;
  }

  .badge-current {
    background: var(--color-accent);
    color: white;
  }

  .badge-remote {
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-foreground-muted);
  }

  /* Card Content */
  .card-content {
    flex: 1;
  }

  .card-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-foreground-hover);
    margin: 0 0 0.25rem 0;
    line-height: 1.3;
  }

  .card-company {
    font-size: 0.9375rem;
    color: var(--color-foreground);
    margin: 0;
  }

  .card-location {
    color: var(--color-foreground-muted);
  }

  .card-highlights {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .card-highlights li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-foreground-muted);
    margin-bottom: 0.5rem;
  }

  .card-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 4px;
    height: 4px;
    background: var(--color-accent);
    border-radius: 50%;
  }

  .card-highlights li:last-child {
    margin-bottom: 0;
  }

  /* Card Footer */
  .card-footer {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .card-duration {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-foreground-muted);
  }

  /* Compact-specific styles */
  .compact .card-footer {
    display: none;
  }

  .compact .card-header {
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .experience-card.featured {
      padding: 1.25rem;
    }

    .card-header {
      flex-direction: column;
      gap: 0.5rem;
    }

    .card-badges {
      order: -1;
    }
  }

  @media print {
    .experience-card.featured,
    .experience-card.compact {
      background: none;
      border: none;
      padding: 0.75rem 0;
      transform: none;
      box-shadow: none;
    }

    .experience-card.featured:not(:last-child),
    .experience-card.compact:not(:last-child) {
      border-bottom: 1px solid #ccc;
    }

    .badge {
      border: 1px solid currentColor;
      background: none !important;
      color: black !important;
    }

    .card-footer {
      display: none;
    }

    .card-highlights li::before {
      background: black;
    }
  }
</style>
