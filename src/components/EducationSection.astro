---
/**
 * EducationSection Component
 * Minimal credential display in product style
 */

import { resume } from '../data/resume';

const { degree, field, institution, graduationYear, honors } = resume.education;
---

<section class="education-section reveal" aria-labelledby="education-heading">
  <div class="education-card">
    <div class="education-main">
      <h2 id="education-heading" class="education-label">Education</h2>
      <h3 class="education-degree">{degree} in {field}</h3>
      <p class="education-details">
        {institution} · <time datetime={String(graduationYear)}>{graduationYear}</time>
      </p>
    </div>
    <div class="education-honors">
      {honors && honors.length > 0 && (
        <ul class="honors-tags" role="list" aria-label="Academic honors">
          {honors.map((honor) => (
            <li class="honor-tag">{honor}</li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .education-section {
    padding: 3rem 0;
    border-top: 1px solid var(--color-overlay);
  }

  .education-card {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }

  .education-label {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground-muted);
    margin: 0 0 0.75rem 0;
  }

  .education-degree {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-foreground-hover);
    margin: 0 0 0.25rem 0;
  }

  .education-details {
    font-size: 0.9375rem;
    color: var(--color-foreground-muted);
    margin: 0;
  }

  .honors-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .honor-tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.375rem 0.75rem;
    background: rgba(87, 94, 207, 0.1);
    color: var(--color-accent);
    border-radius: 4px;
  }

  @media (max-width: 768px) {
    .education-card {
      flex-direction: column;
      gap: 1.25rem;
    }

    .education-honors {
      width: 100%;
    }

    .honors-tags {
      justify-content: flex-start;
    }
  }

  @media print {
    .education-section {
      padding: 1rem 0;
    }

    .education-card {
      display: block;
    }

    .honor-tag {
      background: none;
      border: 1px solid currentColor;
      color: black;
    }

    .education-honors {
      margin-top: 0.5rem;
    }
  }
</style>
