---
/**
 * Summary Component
 * Product-style "About" section with profile picture and key highlights
 */

import { resume } from '../data/resume';

const { name } = resume.contact;

// Derive metrics from resume data (single source of truth)
const highlights = [
  { metric: `${Math.floor(resume.totalYearsExperience)}+`, label: 'Years Experience' },
  { metric: `${resume.experienceByCompany.length}+`, label: 'Companies Served' },
  { metric: `${resume.skills.technical.length}`, label: 'Technical Domains' },
];
---

<section id="about" class="about-section" aria-labelledby="about-heading">
  <div class="about-profile reveal">
    <div class="profile-container">
      <!-- Animated rings and dots behind profile pic -->
      <svg class="profile-rings" viewBox="0 0 280 280" aria-hidden="true">
        <!-- Outer rotating ring -->
        <circle
          class="ring ring-outer"
          cx="140"
          cy="140"
          r="135"
          fill="none"
          stroke="url(#ring-gradient)"
          stroke-width="1.5"
          stroke-dasharray="10 14"
        />
        <!-- Inner rotating ring (opposite direction) -->
        <circle
          class="ring ring-inner"
          cx="140"
          cy="140"
          r="125"
          fill="none"
          stroke="url(#ring-gradient)"
          stroke-width="1.5"
          stroke-dasharray="6 18"
        />
        <!-- Orbiting dots -->
        <g class="orbit orbit-1">
          <circle cx="140" cy="5" r="4" fill="var(--color-accent)" opacity="0.8" />
        </g>
        <g class="orbit orbit-2">
          <circle cx="140" cy="5" r="3" fill="var(--color-purple)" opacity="0.6" />
        </g>
        <g class="orbit orbit-3">
          <circle cx="140" cy="5" r="3.5" fill="var(--color-pink)" opacity="0.7" />
        </g>
        <!-- Gradient definition -->
        <defs>
          <linearGradient id="ring-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.4" />
            <stop offset="50%" stop-color="var(--color-purple)" stop-opacity="0.3" />
            <stop offset="100%" stop-color="var(--color-pink)" stop-opacity="0.4" />
          </linearGradient>
        </defs>
      </svg>
      <img
        src="/profilepic.png"
        alt={`${name} profile photo`}
        class="profile-pic"
        width="240"
        height="240"
      />
    </div>
  </div>

  <div class="about-content reveal" style="animation-delay: 100ms;">
    <header class="about-header">
      <h2 id="about-heading" class="about-title">About</h2>
    </header>
    <p class="about-text">{resume.summary}</p>
  </div>

  <aside class="about-metrics reveal" style="animation-delay: 200ms;" aria-label="Key statistics">
    {highlights.map((item) => (
      <div class="metric-card">
        <span class="metric-value">{item.metric}</span>
        <span class="metric-label">{item.label}</span>
      </div>
    ))}
  </aside>
</section>

<style>
  .about-section {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    gap: 3rem 3rem;
    align-items: start;
    padding: 6rem 0;
    border-top: 1px solid var(--color-overlay);
  }

  .about-profile {
    display: flex;
    align-items: flex-start;
  }

  .about-metrics {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .profile-container {
    position: relative;
    width: 280px;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .profile-rings {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
  }

  .ring-outer {
    animation: spin-slow 25s linear infinite;
    transform-origin: center;
    will-change: transform;
  }

  .ring-inner {
    animation: spin-slow 20s linear infinite reverse;
    transform-origin: center;
    will-change: transform;
  }

  .orbit {
    /* 140px = viewBox (280) / 2, centers rotation on the SVG */
    transform-origin: 140px 140px;
    will-change: transform;
  }

  .orbit-1 {
    animation: orbit 8s linear infinite;
  }

  .orbit-2 {
    animation: orbit 12s linear infinite reverse;
    animation-delay: -4s;
  }

  .orbit-3 {
    animation: orbit 15s linear infinite;
    animation-delay: -9s;
  }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes orbit {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .profile-pic {
    width: 240px;
    height: 240px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-overlay);
    box-shadow:
      0 0 0 4px var(--color-background),
      0 8px 32px rgba(87, 94, 207, 0.3),
      0 0 48px rgba(87, 94, 207, 0.15);
    transition: transform var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
  }

  .profile-pic:hover {
    transform: scale(1.02);
    box-shadow:
      0 0 0 4px var(--color-background),
      0 12px 40px rgba(87, 94, 207, 0.4),
      0 0 64px rgba(87, 94, 207, 0.2);
  }

  .about-header {
    margin-bottom: 1.5rem;
  }

  .about-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-foreground-hover);
    margin: 0;
  }

  .about-text {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-foreground);
    margin: 0;
  }

  .metric-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 2rem;
    background: var(--color-overlay);
    border-radius: 8px;
    transition: background-color var(--duration-fast) var(--ease-out);
    min-width: 160px;
    text-align: center;
  }

  .metric-card:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .metric-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }

  .metric-label {
    font-size: 0.875rem;
    color: var(--color-foreground-muted);
    margin-top: 0.25rem;
  }

  @media (max-width: 900px) {
    .about-section {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .about-profile {
      justify-content: center;
    }

    .profile-container {
      width: 220px;
      height: 220px;
    }

    .profile-pic {
      width: 180px;
      height: 180px;
    }

  }

  @media (max-width: 640px) {
    .about-section {
      padding: 4rem 0;
      gap: 2rem;
    }

    .profile-container {
      width: 180px;
      height: 180px;
    }

    .profile-pic {
      width: 140px;
      height: 140px;
    }

    .about-metrics {
      flex-wrap: wrap;
    }

    .metric-card {
      min-width: 140px;
    }

    .metric-value {
      font-size: 1.5rem;
    }
  }

  @media print {
    .about-section {
      display: block;
      padding: 1rem 0;
    }

    .about-profile,
    .about-metrics {
      display: none;
    }

    .about-text {
      font-size: 10pt;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring-outer,
    .ring-inner,
    .orbit-1,
    .orbit-2,
    .orbit-3 {
      animation: none;
    }
  }
</style>
